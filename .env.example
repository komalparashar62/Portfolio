# SERVER-ONLY. Copy this file to .env.local for local development.
# Add these three values in Vercel > Project Settings > Environment Variables.
# Never prefix these with NEXT_PUBLIC_ or commit actual secrets.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Komal Portfolio <enquiries@your-verified-domain.com>
CONTACT_TO_EMAIL=your-inbox@example.com

# Optional: leave blank to receive enquiries by email without a database.
# If configured, run database/schema.sql in Neon before sending enquiries.
DATABASE_URL=
